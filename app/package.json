{
  "name": "lena-cms",
  "productName": "Lena CMS",
  "version": "1.0.0",
  "description": "Desktop editor for the Elena Ishchenko website",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test \"test/*.test.js\"",
    "build-site": "node scripts/build-site.js",
    "dist": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.44.4",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tiptap-markdown": "^0.9.0",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vuedraggable": "^4.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.github.lena-cms.app",
    "productName": "Lena CMS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "Lena-CMS-${version}.${ext}",
      "hardenedRuntime": false
    }
  },
  "author": "Valia Fetisov"
}
